{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        /* For transpiling with TypeScript: */
        "module": "ESNext",
        "outDir": "../dist/client",
        "rootDir": ".",

        /* If your code doesn't run in the DOM: */
        "lib": ["es2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules", "dist"]
}
