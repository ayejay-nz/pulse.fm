{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        /* For transpiling with TypeScript: */
        "module": "preserve",
        "moduleResolution": "bundler",
        "outDir": "../dist/server",
        "rootDir": ".",

        /* If your code doesn't run in the DOM: */
        "lib": ["es2022"]
    },
    "include": ["src/**/*", "tests/**/*"],
    "exclude": ["node_modules", "dist"]
}
